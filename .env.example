# ============================================================================
# Wintermute Environment Configuration
# Copy to .env and fill in values for your environment.
# ============================================================================

# --- vLLM Inference Server ------------------------------------------------
# Public IP or hostname of the EC2 instance running vLLM.
# Required for talkingHead, DAG retrieval, and agent runner.
VLLM_HOST=107.21.91.80

# --- Database (pgvector / strategic memory) --------------------------------
# Used by mcp-memory and talkingHead strategic memory bridge.
DATABASE_URL=postgresql://wintermute:wintermute@localhost:5432/wintermute

# --- DAG Retrieval (optional overrides) ------------------------------------
# These override shared_api_config.json values if set.
# DAG_LLM_BASE_URL=http://localhost:8010/v1
# DAG_LLM_MODEL=wintermute-mistral-7b-sft
# DAG_LLM_TIMEOUT=30

# --- Embedding Model (mcp-memory) -----------------------------------------
# MCP_MEMORY_EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- WebSocket Connection Limits -------------------------------------------
# WS_MAX_CONNECTIONS=200

# --- Debug Mode ------------------------------------------------------------
# Set to "true" for verbose logging in talkingHead backend
# DEBUG=false

# --- HuggingFace -----------------------------------------------------------
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- AWS -------------------------------------------------------------------
# AWS_PROFILE=experimental-admin
# AWS_DEFAULT_REGION=us-east-1

# --- Service Limits (mcp-memory) -------------------------------------------
# Maximum results returned by memory_search / memory_recall_recent.
# MCP_MEMORY_SEARCH_MAX=50
# MCP_MEMORY_RECALL_MAX=100

# --- Service Limits (mcp-postgres) -----------------------------------------
# Default and hard caps on rows returned by sql_query; sample-rows tool cap.
# MCP_PG_MAX_ROWS=200
# MCP_PG_MAX_ROWS_HARD=1000
# MCP_PG_SAMPLE_MAX=20

# --- Agent Runner ----------------------------------------------------------
# HTTP timeout (seconds) for LLM calls in agents/runner.py.
# AGENT_LLM_TIMEOUT=120

# --- talkingHead Chat / LLM ------------------------------------------------
# Streaming HTTP timeouts for LLM in talkingHead chat (seconds).
# LLM_CONNECT_TIMEOUT=10
# LLM_READ_TIMEOUT=300
# LLM_WRITE_TIMEOUT=10

# --- talkingHead Memory / History ------------------------------------------
# Default limits for strategic memory search and recent chat history fetch.
# STRATEGIC_MEMORY_SEARCH_LIMIT=3
# CHAT_HISTORY_LIMIT=20

# --- Freud Auditor ---------------------------------------------------------
# FREUD_DUPLICATE_THRESHOLD=0.92
# FREUD_CONTRADICTION_MIN=0.65
# FREUD_CONTRADICTION_MAX=0.90
# FREUD_MIN_TEXT_LENGTH=20
# FREUD_STALE_DAYS=14
# FREUD_TRUST_BOOST_CLEAN=0.15
# FREUD_TRUST_PENALTY_FLAGGED=0.2
# FREUD_AUTO_PROMOTE_THRESHOLD=0.8
