# --- Vite / Frontend ---
.vitepress
.vite

# Build output
frontend/dist
frontend/.vite
frontend/node_modules/

# Local env vars or secrets (if any)
frontend/.env
frontend/.env.*

# --- Python / Backend ---
# Byte-compiled / cache files
__pycache__/
*.py[cod]
*.so

# Virtual environment
.venv/
venv/
env/
env.bak/
*.pyenv

# Python env/var files
backend/.env
backend/.env.*

# Pyright or VS Code Python configs
pyrightconfig.json
backend/.mypy_cache/
backend/.pytest_cache/

# Uvicorn or gunicorn logs (if used)
*.log

# Root env files
.env
.env.local

# Local SQLite databases (chat history, etc.)
wintermute_chat.db
*.sqlite
*.sqlite3

# --- General ---
# Node modules (global)
node_modules/

# System files
Thumbs.db
ehthumbs.db
*.swp
*.swo
.DS_Store

# Optional: ignore shell history
.history
.bash_history
.zsh_history


memory/chroma_store/

