#!/usr/bin/env bash
# Wintermute pre-commit lint gate + knowledge graph auto-update
# Catches deterministic bugs before they reach code review.
# Bypass graphify with: SKIP_GRAPHIFY=1 git commit
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

# ── Python: ruff ──────────────────────────────────────────────────────────────
if command -v ruff >/dev/null 2>&1; then
  echo "pre-commit: ruff..."
  ruff check . --select F,E7 --output-format=concise || exit 1
fi

# ── Shell scripts: shellcheck ─────────────────────────────────────────────────
if command -v shellcheck >/dev/null 2>&1; then
  echo "pre-commit: shellcheck..."
  sh_files=$(git ls-files '*.sh' '*.bash')
  if [ -n "$sh_files" ]; then
    echo "$sh_files" | xargs shellcheck --severity=error || exit 1
  fi
fi

# ── TypeScript / JavaScript: eslint ───────────────────────────────────────────
# Only runs when the repo has an ESLint config (talkingHead/frontend has one).
have_eslint_config() {
  [ -f eslint.config.js ] || [ -f eslint.config.mjs ] || [ -f eslint.config.cjs ] ||
    [ -f .eslintrc ] || [ -f .eslintrc.js ] || [ -f .eslintrc.cjs ] ||
    [ -f .eslintrc.json ] || [ -f .eslintrc.yml ] || [ -f .eslintrc.yaml ]
}
ts_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|js|jsx)$' || true)
if [ -n "$ts_files" ] && command -v npx >/dev/null 2>&1; then
  # Run eslint in each subdirectory that has a config
  for dir in talkingHead/frontend; do
    if [ -d "$REPO_ROOT/$dir" ] && (cd "$REPO_ROOT/$dir" && have_eslint_config); then
      echo "pre-commit: eslint ($dir)..."
      staged_in_dir=$(echo "$ts_files" | grep "^$dir/" || true)
      if [ -n "$staged_in_dir" ]; then
        cd "$REPO_ROOT/$dir"
        npx eslint --max-warnings=0 $staged_in_dir || exit 1
        cd "$REPO_ROOT"
      fi
    fi
  done
fi

# ── Python dependency audit: pip-audit ────────────────────────────────────────
# Only runs when requirements.txt changes (expensive — skip on unrelated commits)
req_changed=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^requirements.*\.txt$' || true)
if [ -n "$req_changed" ] && command -v pip-audit >/dev/null 2>&1; then
  echo "pre-commit: pip-audit..."
  pip-audit --requirement requirements.txt --skip-editable || exit 1
fi

echo "pre-commit: lint gate passed."

# ── Update knowledge graph (graphify) ────────────────────────────────────────
# Incrementally re-extracts code files staged in this commit and merges
# them into graphify-out/graph.json. Best-effort — never blocks a commit.
# Bypass with: SKIP_GRAPHIFY=1 git commit
if [[ "${SKIP_GRAPHIFY:-0}" == "1" ]]; then
  echo "pre-commit: graphify update skipped (SKIP_GRAPHIFY=1)."
elif [[ ! -f "$REPO_ROOT/graphify-out/graph.json" ]]; then
  echo "pre-commit: graphify-out/graph.json not found — run /graphify to build initial graph."
elif [[ ! -f "$REPO_ROOT/graphify-out/.graphify_python" ]]; then
  echo "pre-commit: .graphify_python missing — skipping graph update." >&2
else
  echo "pre-commit: updating knowledge graph..."
  GRAPHIFY_PYTHON="$(cat "$REPO_ROOT/graphify-out/.graphify_python")"

  STAGED_CODE="$(git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '\.(py|sh|ts|js|go|rs|java|rb|cs|cpp|c)$' || true)"

  if [[ -z "$STAGED_CODE" ]]; then
    echo "pre-commit: no code file changes — skipping graph update."
  else
    FILE_COUNT=$(echo "$STAGED_CODE" | wc -l | tr -d ' ')
    echo "pre-commit: re-extracting $FILE_COUNT changed code file(s)..."

    cd "$REPO_ROOT"
    "$GRAPHIFY_PYTHON" -c "
import json, sys
from graphify.extract import extract
from graphify.build import build_merge
from graphify.cluster import cluster, score_all
from graphify.analyze import god_nodes, surprising_connections, suggest_questions
from graphify.report import generate
from graphify.export import to_json
from pathlib import Path

repo = Path('$REPO_ROOT')
staged = '''$STAGED_CODE'''.strip().splitlines()
code_files = [repo / f for f in staged if (repo / f).exists()]
if not code_files:
    print('pre-commit: no valid staged files found.')
    sys.exit(0)

ast_result = extract(code_files, cache_root=repo)
new_extraction = {'nodes': ast_result['nodes'], 'edges': ast_result['edges'], 'hyperedges': [], 'input_tokens': 0, 'output_tokens': 0}

G = build_merge([new_extraction], graph_path=str(repo / 'graphify-out/graph.json'))

labels_path = repo / 'graphify-out/.graphify_labels.json'
labels = json.loads(labels_path.read_text(encoding='utf-8')) if labels_path.exists() else {}
labels = {int(k): v for k, v in labels.items()}
communities = cluster(G)
for cid in communities:
    if cid not in labels:
        labels[cid] = f'Community {cid}'
cohesion = score_all(G, communities)

detection = {'total_files': G.number_of_nodes(), 'total_words': 0, 'files': {}}
gods = god_nodes(G)
surprises = surprising_connections(G, communities)
questions = suggest_questions(G, communities, labels)
report = generate(G, communities, cohesion, labels, gods, surprises, detection, {'input': 0, 'output': 0}, '.', suggested_questions=questions)
(repo / 'graphify-out/GRAPH_REPORT.md').write_text(report, encoding='utf-8')
to_json(G, communities, str(repo / 'graphify-out/graph.json'))
(repo / 'graphify-out/.graphify_labels.json').write_text(json.dumps({str(k): v for k, v in labels.items()}, ensure_ascii=False), encoding='utf-8')
print(f'pre-commit: graph updated — {G.number_of_nodes()} nodes, {G.number_of_edges()} edges')
" 2>&1 | sed 's/^/  /'

    git add "$REPO_ROOT/graphify-out/graph.json" \
            "$REPO_ROOT/graphify-out/GRAPH_REPORT.md" \
            "$REPO_ROOT/graphify-out/.graphify_labels.json" 2>/dev/null || true
    echo "pre-commit: graphify-out/ changes staged."
  fi
fi
