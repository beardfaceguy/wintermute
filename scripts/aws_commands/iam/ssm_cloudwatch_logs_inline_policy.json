{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SSMRunCommandCloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:DescribeLogStreams",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:491794274773:log-group:/aws/ssm/titan-llm-training:*"
    },
    {
      "Sid": "SSMRunCommandDescribeLogGroups",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "*"
    },
    {
      "Sid": "SSMRunCommandCreateLogGroupNamed",
      "Effect": "Allow",
      "Action": "logs:CreateLogGroup",
      "Resource": "arn:aws:logs:us-east-1:491794274773:log-group:/aws/ssm/titan-llm-training"
    }
  ]
}
